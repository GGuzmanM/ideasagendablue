# ─── Base de datos / infraestructura ─────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/limablue_agenda"
REDIS_URL="redis://localhost:6379"

# ─── Autenticación ────────────────────────────────────────────────────────────
JWT_SECRET="limablue-jwt-secret-change-in-production"
JWT_EXPIRES_IN="8h"

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=development
# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN="http://localhost:5180"

# ─── Sistema de Confirmación por Correo (Gmail API + OAuth 2.0) ────────────────
# IMPORTANTE (portabilidad): TODOS los enlaces del correo se construyen con estas
# URLs. Al pasar a producción, cambia SOLO estos valores a tus dominios https://.
API_BASE_URL="http://localhost:3002"           # backend (donde viven /confirmar y /cancelar)
APP_BASE_URL="http://localhost:5180"           # frontend (a dónde vuelve el usuario tras OAuth)

# Secreto independiente para firmar los tokens de los enlaces Confirmar/Cancelar.
# OBLIGATORIO en producción. Genera uno largo y aleatorio.
CONFIRM_TOKEN_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
CONFIRM_TOKEN_EXPIRES_IN="30d"

# Secreto para firmar las URLs de archivos privados (/uploads: comprobantes, contratos).
# Si se omite, se reutiliza JWT_SECRET. Recomendado definir uno propio en producción.
ARCHIVO_FIRMA_SECRET=""

# Credenciales del proyecto OAuth de Google Cloud (ver README · sección OAuth).
# El REDIRECT_URI debe coincidir EXACTAMENTE con el registrado en Google Cloud y
# apuntar a: <API_BASE_URL>/api/v1/herramientas/mail-config/oauth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3002/api/v1/herramientas/mail-config/oauth/callback"

# Opcional: refresh token de respaldo. Normalmente NO hace falta ponerlo aquí,
# porque tras pulsar "Conectar cuenta de Google" se guarda en la tabla MailConfig
# de la base de datos. Útil solo para sembrar una cuenta sin pasar por la UI.
GOOGLE_REFRESH_TOKEN=""

# Remitente por defecto. El admin puede cambiarlo desde la UI (se guarda en DB).
# Debe coincidir con la cuenta de Gmail que autorices en el flujo OAuth.
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="Limablue Podología"

# ── Resend (proveedor de correo actual) ───────────────────────────────────────
# API key estática de Resend. El dominio limablue.pe debe estar verificado en
# Resend. La key SOLO vive aquí (env); nunca en la base de datos ni en la UI.
RESEND_API_KEY=""
MAIL_DRY_RUN=true

# Secreto para validar la firma (svix) de los webhooks entrantes de Resend
# (POST /api/v1/webhooks/resend): email.delivered / email.bounced / email.complained.
RESEND_WEBHOOK_SECRET=""

# ── Outlook Calendar (Microsoft Graph) — sincroniza citas de Yasica/Daniel Doy ──
# App en Azure AD/Entra ID con permiso de APLICACIÓN Calendars.ReadWrite (+ consentimiento admin)
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# ── Consulta de DNI RENIEC (PeruDevs - api.perudevs.com) ──
PERUDEVS_DNI_URL="https://api.perudevs.com/api/v1/dni/complete"
PERUDEVS_DNI_TOKEN=""
RENIEC_API_TOKEN=""

# ── Recordatorios por correo (2h antes de la cita) ──
RECORDATORIOS_ACTIVOS="true"
RECORDATORIOS_WORKER_INLINE="true"
MAIL_LIMITE_DIARIO="500"

# ── WhatsApp de Limablue (botón "Reprogramar" del recordatorio; formato 51XXXXXXXXX sin +) ──
WHATSAPP_NUMERO="51919296464"

# ── Reserva web (sin pasarela de pago): página /reserva y API del chat de WhatsApp ──
# La cita se crea al confirmar; se paga en la sede. Los servicios que se ofrecen son los marcados servicios.reservaOnline.
# RESERVA_WEB_HABILITADA="1" enciende la página pública /reserva (la API del chat no depende de este interruptor).
# RESERVA_WEB_API_KEY: llave INTERNA con la que la Agenda crea la cita (la genera «Reserva web de prueba.bat» / «Llave API del chat.bat»).
# RESERVA_WEB_API_INTERNA: dirección interna del API (por defecto http://127.0.0.1:PORT). RESERVA_WEB_DIAS_MAX (30) y
# RESERVA_WEB_ANTICIPACION_MIN (120: para reservar hoy, al menos 2 h antes).
RESERVA_WEB_HABILITADA=""
RESERVA_WEB_API_KEY=""

# ── Pago en línea con Niubiz (Botón de Pago Web) — APAGADO por defecto ──
# NIUBIZ_HABILITADO="1" enciende el pago en la reserva web. NIUBIZ_ENTORNO: "sandbox" (pruebas, no cobra dinero real) o "produccion".
# Las credenciales de producción las entrega Niubiz y van SOLO en agenda.env (nunca en el repositorio ni en chats).
# RESERVA_WEB_PAGO: "opcional" (el paciente elige pagar ahora o en la sede) u "obligatorio". NIUBIZ_LIQUIDACION: "automatica" (recomendada) o "manual".
# NIUBIZ_MINUTOS_PAGO (10): cuánto se aparta el horario mientras el paciente paga. RESERVA_WEB_URL_PUBLICA: https://dominio de la Agenda (si no, se toma del pedido).
# NIUBIZ_URL_API / NIUBIZ_CHECKOUT_JS: solo para apuntar a un Niubiz simulado (apps/api/scripts/niubiz-simulado.cjs).
NIUBIZ_HABILITADO=""
NIUBIZ_ENTORNO="sandbox"
NIUBIZ_MERCHANT_ID=""
NIUBIZ_USUARIO=""
NIUBIZ_CLAVE=""
NIUBIZ_LIQUIDACION="automatica"
RESERVA_WEB_PAGO="opcional"
